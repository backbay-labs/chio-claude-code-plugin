@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Explicit Docker bindings must fail before launching a different resource owner."""
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import types
+import unittest
+from unittest.mock import patch
+
+SPEC = importlib.util.spec_from_file_location(
+    "resource_owner", Path(__file__).resolve().parents[1] / "serve-filesystem.py")
+OWNER = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(OWNER)
+
+
+class DockerBindingTest(unittest.TestCase):
+    def setUp(self):
+        self.context = "chio-qualification"
+        self.executable = "/usr/bin/docker"
+        self.endpoint = {"Host": "unix:///var/run/docker.sock", "SkipTLSVerify": False}
+        self.info = {"ID": "daemon-one", "Architecture": "x86_64", "OSType": "linux"}
+
+    def docker_run(self, *args):
+        self.assertEqual(args[:3], (self.executable, "--context", self.context))
+        if args[3] == "context":
+            self.assertEqual(args[4:7], ("inspect", self.context, "--format"))
+            value = self.endpoint
+        else:
+            self.assertEqual(args[3:5], ("info", "--format"))
+            value = self.info
+        return types.SimpleNamespace(stdout=json.dumps(value))
+
+    def operator(self):
+        selected = OWNER.docker_selection(self.context, self.executable)
+        return {"dockerSelection": selected, "dockerExecutable": self.executable,
+                "command": ["/opt/chio", "mcp", "serve-http", "--", self.executable,
+                            "--context", self.context, "run", "image"]}
+
+    def test_explicit_selection_and_stable_restart(self):
+        with patch.object(OWNER, "run", side_effect=self.docker_run) as calls:
+            operator = self.operator()
+            OWNER.validate_docker_selection(operator)
+            self.assertEqual(calls.call_count, 4)
+            self.assertEqual(operator["dockerSelection"]["daemonId"], "daemon-one")
+
+    def test_changed_daemon_refuses_restart(self):
+        with patch.object(OWNER, "run", side_effect=self.docker_run):
+            operator = self.operator()
+            self.info["ID"] = "daemon-two"
+            with self.assertRaisesRegex(ValueError, "daemon changed"):
+                OWNER.validate_docker_selection(operator)
+
+    def test_changed_endpoint_refuses_restart(self):
+        with patch.object(OWNER, "run", side_effect=self.docker_run):
+            operator = self.operator()
+            self.endpoint["Host"] = "unix:///another/daemon.sock"
+            with self.assertRaisesRegex(ValueError, "endpoint or daemon changed"):
+                OWNER.validate_docker_selection(operator)
+
+    def test_command_cannot_drop_or_replace_context(self):
+        with patch.object(OWNER, "run", side_effect=self.docker_run):
+            operator = self.operator()
+            operator["command"][6] = "default"
+            with self.assertRaisesRegex(ValueError, "command no longer binds"):
+                OWNER.validate_docker_selection(operator)
+
+    def test_unreachable_daemon_does_not_fall_back(self):
+        with patch.object(OWNER, "run", side_effect=subprocess.CalledProcessError(1, ["docker"])):
+            with self.assertRaises(subprocess.CalledProcessError):
+                OWNER.docker_selection(self.context, self.executable)
+
+    def test_empty_daemon_identity_and_legacy_owner_refused(self):
+        with patch.object(OWNER, "run", side_effect=self.docker_run):
+            self.info["ID"] = ""
+            with self.assertRaisesRegex(ValueError, "identified, reachable"):
+                OWNER.docker_selection(self.context, self.executable)
+        with self.assertRaisesRegex(ValueError, "explicit Docker binding"):
+            OWNER.validate_docker_selection({"command": ["docker", "run"]})
+
+    def test_context_is_required_and_cannot_be_an_option(self):
+        for context in (None, "", "--host", "bad/name"):
+            with self.subTest(context=context), self.assertRaises(ValueError):
+                OWNER.docker_selection(context, self.executable)
+
+    def test_restart_validates_binding_before_signaling_the_running_owner(self):
+        with patch.object(OWNER, "run", side_effect=self.docker_run):
+            operator = self.operator()
+            self.info["ID"] = "replacement-daemon"
+            with tempfile.TemporaryDirectory() as directory:
+                (Path(directory) / "operator.json").write_text(json.dumps(operator))
+                args = types.SimpleNamespace(state_dir=directory, action="restart")
+                with patch.object(OWNER.os, "kill") as signal:
+                    with self.assertRaisesRegex(ValueError, "daemon changed"):
+                        OWNER.lifecycle(args)
+                    signal.assert_not_called()
+
+
+class ManifestIdentityTest(unittest.TestCase):
+    def material(self, directory, manifest=None):
+        directory = Path(directory)
+        manifest_path = directory / "manifest.json"
+        manifest_path.write_text(json.dumps({"manifest": manifest or {
+            "server_id": "fs", "name": "Reviewed resource", "version": "7.2"}}))
+        policy = directory / "policy.json"
+        policy.write_text("{}")
+        keyring = directory / "keyring.json"
+        keyring.write_text("{}")
+        for path in (manifest_path, policy, keyring):
+            path.chmod(0o600)
+        return {"signedManifest": OWNER.launch_file(manifest_path),
+                "manifestPublicKey": "a" * 64, "cagePolicy": OWNER.launch_file(policy),
+                "cagePolicySigner": "b" * 64,
+                "resumeHmacKeyring": OWNER.launch_file(keyring, private=True)}
+
+    def test_runtime_uses_the_admitted_manifest_identity_and_refuses_default_substitution(self):
+        with tempfile.TemporaryDirectory() as directory:
+            material = self.material(directory)
+            arguments = OWNER.launch_arguments(material)
+            operator = {"launchMaterial": material, "command": ["/opt/chio", *arguments]}
+            OWNER.validate_launch_material(operator)
+            self.assertEqual(arguments[arguments.index("--server-name") + 1], "Reviewed resource")
+            self.assertEqual(arguments[arguments.index("--server-version") + 1], "7.2")
+            operator["command"][operator["command"].index("--server-name") + 1] = "fs"
+            with self.assertRaisesRegex(ValueError, "no longer binds"):
+                OWNER.validate_launch_material(operator)
+
+    def test_foreign_manifest_identity_is_rejected(self):
+        with tempfile.TemporaryDirectory() as directory:
+            material = self.material(directory, {"server_id": "foreign", "name": "Server", "version": "1"})
+            with self.assertRaisesRegex(ValueError, "server identity"):
+                OWNER.launch_arguments(material)
+
+    def test_changed_manifest_refuses_restart_before_signaling(self):
+        with tempfile.TemporaryDirectory() as directory:
+            material = self.material(directory)
+            operator = {"launchMaterial": material, "command": ["/opt/chio", *OWNER.launch_arguments(material)]}
+            (Path(directory) / "operator.json").write_text(json.dumps(operator))
+            Path(material["signedManifest"]["path"]).write_text('{"manifest":{"server_id":"fs","name":"Changed","version":"7.2"}}')
+            with patch.object(OWNER, "validate_docker_selection"), patch.object(OWNER.os, "kill") as signal:
+                with self.assertRaisesRegex(ValueError, "launch input changed"):
+                    OWNER.lifecycle(types.SimpleNamespace(state_dir=directory, action="restart"))
+                signal.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
