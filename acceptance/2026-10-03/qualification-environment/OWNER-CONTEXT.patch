+def docker_selection(context, executable):
+    """Resolve an explicit context without changing the operator's active one."""
+    if not isinstance(context, str) or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}", context):
+        raise ValueError("select one explicit Docker context name")
+    prefix = [executable, "--context", context]
+    endpoint = json.loads(run(*prefix, "context", "inspect", context,
+                              "--format", "{{json .Endpoints.docker}}").stdout)
+    info = json.loads(run(*prefix, "info", "--format", "{{json .}}").stdout)
+    if (not isinstance(endpoint, dict) or not isinstance(endpoint.get("Host"), str)
+            or not endpoint["Host"] or not isinstance(info, dict)
+            or not isinstance(info.get("ID"), str) or not info["ID"]):
+        raise ValueError("Docker context must resolve to an identified, reachable daemon")
+    return {"context": context, "endpoint": endpoint, "daemonId": info["ID"],
+            "architecture": info.get("Architecture"), "osType": info.get("OSType")}
+
+
+def validate_docker_selection(operator):
+    recorded = operator.get("dockerSelection")
+    executable = operator.get("dockerExecutable")
+    if not isinstance(recorded, dict) or not isinstance(executable, str) or not Path(executable).is_absolute():
+        raise ValueError("owner lacks an explicit Docker binding; qualify a migration without replacing its state")
+    if docker_selection(recorded.get("context"), executable) != recorded:
+        raise ValueError("Docker endpoint or daemon changed; preserve state and qualify an explicit migration")
+    command = operator.get("command", [])
+    if "--" not in command or command[command.index("--") + 1:command.index("--") + 5] != [
+            executable, "--context", recorded["context"], "run"]:
+        raise ValueError("owner command no longer binds the selected Docker context")
+
+
 def start(args):
     material = selected_launch_material(args)
