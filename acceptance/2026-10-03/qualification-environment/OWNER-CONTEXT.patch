@@ -0,0 +1,42 @@
+# Qualification build from clean Chio source de84fc306efbb4c8dd6de748d0ad2a8d695fd30e.
+# Native ARM compilation produces Linux x86_64 artifacts; execution occurs in the x86_64 guest.
+FROM rust:1.94.1-bookworm@sha256:55912ad77b52c411af5ecb4cf8901199b3688dbc96bf979570bbd8834dac69aa AS build
+RUN dpkg --add-architecture amd64 \
+ && apt-get update \
+ && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu g++-x86-64-linux-gnu libssl-dev:amd64 cmake clang pkg-config \
+ && rustup target add x86_64-unknown-linux-gnu x86_64-unknown-linux-musl \
+ && dpkg-query -W > /build-packages.txt
+ENV CARGO_BUILD_JOBS=3 CARGO_INCREMENTAL=0 \
+ CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
+ CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=x86_64-linux-gnu-gcc \
+ CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
+ CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++ \
+ CC_x86_64_unknown_linux_musl=x86_64-linux-gnu-gcc \
+ PKG_CONFIG_ALLOW_CROSS=1 PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig \
+ CARGO_PROFILE_DOCKER_RELEASE_OPT_LEVEL=1 CARGO_PROFILE_DOCKER_RELEASE_LTO=false CARGO_PROFILE_DOCKER_RELEASE_CODEGEN_UNITS=16 CARGO_PROFILE_DOCKER_RELEASE_OVERFLOW_CHECKS=true
+WORKDIR /workspace
+COPY Cargo.toml Cargo.lock ./
+COPY .cargo ./.cargo
+COPY crates ./crates
+COPY third_party ./third_party
+COPY bench ./bench
+COPY examples ./examples
+COPY integrations ./integrations
+COPY tests ./tests
+COPY xtask ./xtask
+COPY fixtures/proof-room ./fixtures/proof-room
+COPY spec ./spec
+COPY wit ./wit
+COPY formal ./formal
+RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
+ --mount=type=cache,target=/workspace/target,sharing=locked \
+ cargo metadata --format-version 1 --locked >/dev/null \
+ && cargo build --locked --profile docker-release --target x86_64-unknown-linux-gnu -p chio-cli --bin chio \
+ && cargo build --locked --profile docker-release --target x86_64-unknown-linux-musl -p chio-cage --bin chio-cage-init \
+ && mkdir /artifacts \
+ && cp target/x86_64-unknown-linux-gnu/docker-release/chio target/x86_64-unknown-linux-musl/docker-release/chio-cage-init /artifacts/ \
+ && cp /build-packages.txt Cargo.lock /artifacts/ \
+ && rustc -Vv > /artifacts/rustc.txt \
+ && sha256sum /artifacts/chio /artifacts/chio-cage-init > /artifacts/SHA256SUMS
+FROM scratch
+COPY --from=build /artifacts /artifacts
