{
  "name": "@chio/claude-code-plugin",
  "version": "0.4.0-rc.3",
  "description": "Native Chio session controls and kernel MCP execution for Claude Code",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".claude-plugin",
    "commands",
    "hooks",
    "scripts",
    "examples",
    "README.md",
    "LICENSE",
    "vendor",
    "docs/RESTRICTED-MODE.md",
    "acceptance/2026-09-09/REPORT.md",
    "acceptance/2026-09-09/ACCEPTANCE.json",
    "docs/assets",
    "types",
    "docs/NATIVE-MODS.md",
    "tsconfig.mod.json",
    "docs/host-contract.json",
    "acceptance/2026-10-03/native-mods",
    "docs/CONTROLLED-TASKS.md",
    "acceptance/2026-10-03/controlled-workflows",
    "acceptance/2026-10-03/qualification-environment"
  ],
  "scripts": {
    "build": "npm run build:types && npm run bundle",
    "build:types": "tsc --emitDeclarationOnly",
    "bundle": "node ./scripts/bundle.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.mod.json",
    "test": "node --test ./test/*.test.mjs",
    "prepack": "node -e \"throw new Error('Use npm run pack:release for a self-contained staged artifact')\"",
    "pack:release": "node scripts/pack-release.mjs",
    "test:mods": "node scripts/test-mods.mjs"
  },
  "keywords": [
    "chio",
    "claude-code",
    "plugin",
    "receipts",
    "capabilities",
    "agent-governance"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chio-protocol/sdk": "file:vendor/chio-protocol-sdk-0.1.1-rc.1-ea8639364db1.tgz",
    "@chio/bridge": "file:vendor/chio-bridge-0.3.0-7d9e34f7408a.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/backbay-labs/chio-claude-code-plugin.git"
  }
}
